// Native Photoshop helpers; caller supplies paths. Original EC API retained.
var EC=(function(){
function c(v){return charIDToTypeID(v);} function s(v){return stringIDToTypeID(v);}
function color(hex){var v=new SolidColor();v.rgb.hexValue=hex.replace(/^#/,'');return v;}
function begin(){var r={units:app.preferences.rulerUnits,typeUnits:app.preferences.typeUnits,dialogs:app.displayDialogs,activeDocumentId:app.documents.length?app.activeDocument.id:null};app.preferences.rulerUnits=Units.PIXELS;app.preferences.typeUnits=TypeUnits.PIXELS;app.displayDialogs=DialogModes.NO;return r;}
function end(r){app.preferences.rulerUnits=r.units;if(r.typeUnits!==undefined)app.preferences.typeUnits=r.typeUnits;app.displayDialogs=r.dialogs;if(r.activeDocumentId!==null)for(var i=0;i<app.documents.length;i++)if(app.documents[i].id===r.activeDocumentId){app.activeDocument=app.documents[i];break;}}
function selectRect(d,b){app.activeDocument=d;var x=b[0],y=b[1],w=b[2],h=b[3];d.selection.select([[x,y],[x+w,y],[x+w,y+h],[x,y+h]]);}
function rect(d,n,x,y,w,h,hex){app.activeDocument=d;var l=d.artLayers.add();l.name=n;selectRect(d,[x,y,w,h]);d.selection.fill(color(hex));d.selection.deselect();return l;}
function text(d,n,value,x,y,size,hex,font){app.activeDocument=d;var l=d.artLayers.add();l.kind=LayerKind.TEXT;l.name=n;if(font)l.textItem.font=font;l.textItem.size=UnitValue(size,'px');l.textItem.position=[UnitValue(x,'px'),UnitValue(y,'px')];l.textItem.color=color(hex);l.textItem.contents=value.replace(/\r\n|\n/g,'\r');l.textItem.horizontalScale=100;l.textItem.verticalScale=100;l.textItem.fauxBold=false;l.textItem.fauxItalic=false;return l;}
function fit(l,x,y,w,h,cover){var b=l.bounds,bw=b[2].as('px')-b[0].as('px'),bh=b[3].as('px')-b[1].as('px');if(bw<=0||bh<=0)throw Error('Empty image bounds');var z=(cover?Math.max(w/bw,h/bh):Math.min(w/bw,h/bh))*100;l.resize(z,z,AnchorPosition.TOPLEFT);b=l.bounds;bw=b[2].as('px')-b[0].as('px');bh=b[3].as('px')-b[1].as('px');l.translate(x+(w-bw)/2-b[0].as('px'),y+(h-bh)/2-b[1].as('px'));}
function placeEmbedded(d,path,n){var f=new File(path);if(!f.exists)throw Error('Missing image: '+path);app.activeDocument=d;var a=new ActionDescriptor();a.putPath(c('null'),f);a.putEnumerated(c('FTcs'),c('QCSt'),c('Qcsa'));executeAction(c('Plc '),a,DialogModes.NO);var l=d.activeLayer;l.name=n;if(l.kind!==LayerKind.SMARTOBJECT)throw Error('Place did not produce smart object: '+n);return l;}
function placeImage(d,path,n,x,y,w,h,cover,rotation){var l=placeEmbedded(d,path,n);if(rotation)l.rotate(rotation,AnchorPosition.MIDDLECENTER);fit(l,x,y,w,h,cover);return l;}
function frameMask(d,l,b){app.activeDocument=d;d.activeLayer=l;selectRect(d,b);var a=new ActionDescriptor(),r=new ActionReference();a.putClass(c('Nw  '),c('Chnl'));r.putEnumerated(c('Chnl'),c('Chnl'),c('Msk '));a.putReference(c('At  '),r);a.putEnumerated(c('Usng'),c('UsrM'),c('RvlS'));executeAction(c('Mk  '),a,DialogModes.NO);d.selection.deselect();d.activeChannels=d.componentChannels;}
function replaceImage(d,l,path){app.activeDocument=d;d.activeLayer=l;if(l.kind!==LayerKind.SMARTOBJECT)throw Error('Replacement target must be a smart object');var f=new File(path);if(!f.exists)throw Error('Missing replacement image: '+path);var a=new ActionDescriptor();a.putPath(c('null'),f);executeAction(s('placedLayerReplaceContents'),a,DialogModes.NO);return d.activeLayer;}
function rgbDescriptor(hex){var rgb=color(hex).rgb,a=new ActionDescriptor();a.putDouble(c('Rd  '),rgb.red);a.putDouble(c('Grn '),rgb.green);a.putDouble(c('Bl  '),rgb.blue);return a;}
function effects(d,l,v){
 if(!v.stroke&&!v.shadow)return;app.activeDocument=d;d.activeLayer=l;
 var all=new ActionDescriptor();all.putUnitDouble(c('Scl '),c('#Prc'),100);
 if(v.stroke){var p=v.stroke,a=new ActionDescriptor(),positions={outside:'OutF',inside:'InsF',center:'CtrF'};
 a.putBoolean(c('enab'),true);a.putBoolean(s('present'),true);a.putBoolean(s('showInDialog'),true);
 a.putEnumerated(c('Styl'),c('FStl'),c(positions[p.position||'outside']));a.putEnumerated(c('PntT'),c('FrFl'),c('SClr'));a.putEnumerated(c('Md  '),c('BlnM'),c('Nrml'));a.putUnitDouble(c('Opct'),c('#Prc'),100);a.putUnitDouble(c('Sz  '),c('#Pxl'),p.size);a.putObject(c('Clr '),c('RGBC'),rgbDescriptor(p.color));all.putObject(c('FrFX'),c('FrFX'),a);}
 if(v.shadow){var p=v.shadow,a=new ActionDescriptor();a.putBoolean(c('enab'),true);a.putBoolean(s('present'),true);a.putBoolean(s('showInDialog'),true);a.putEnumerated(c('Md  '),c('BlnM'),c('Mltp'));a.putObject(c('Clr '),c('RGBC'),rgbDescriptor(p.color));a.putUnitDouble(c('Opct'),c('#Prc'),p.opacity);a.putBoolean(c('uglg'),false);a.putUnitDouble(c('lagl'),c('#Ang'),p.angle);a.putUnitDouble(c('Dstn'),c('#Pxl'),p.distance);a.putUnitDouble(c('Ckmt'),c('#Pxl'),p.spread||0);a.putUnitDouble(c('blur'),c('#Pxl'),p.blur);a.putBoolean(c('AntA'),false);all.putObject(c('DrSh'),c('DrSh'),a);}
 var a=new ActionDescriptor(),r=new ActionReference();r.putProperty(c('Prpr'),c('Lefx'));r.putIdentifier(c('Lyr '),l.id);a.putReference(c('null'),r);a.putObject(c('T   '),c('Lefx'),all);executeAction(c('setd'),a,DialogModes.NO);
}
function styledText(d,v){var p=v.position||[v.box[0],v.box[1]],l=text(d,v.id+' | '+(v.name||v.id),v.text,p[0],p[1],v.size,v.color,v.font),t=l.textItem;if(v.box){t.kind=TextType.PARAGRAPHTEXT;t.width=UnitValue(v.box[2],'px');t.height=UnitValue(v.box[3],'px');t.position=[UnitValue(v.box[0],'px'),UnitValue(v.box[1],'px')];}t.justification={left:Justification.LEFT,center:Justification.CENTER,right:Justification.RIGHT}[v.align||'left'];t.tracking=v.tracking===undefined?0:v.tracking;if(v.leading!==undefined){t.useAutoLeading=false;t.leading=UnitValue(v.leading,'px');}else t.useAutoLeading=true;if(v.rotation)l.rotate(v.rotation,AnchorPosition.MIDDLECENTER);return l;}
function assertFonts(layers){var available={},i;for(i=0;i<app.fonts.length;i++)available[app.fonts[i].postScriptName]=true;for(i=0;i<layers.length;i++)if(layers[i].type==='text'&&!available[layers[i].font])throw Error('Font unavailable (no automatic substitution): '+layers[i].font);}
function layerEvidence(l){var r=new ActionReference();r.putIdentifier(c('Lyr '),l.id);var a=executeActionGet(r),b=l.bounds,row={name:l.name,kind:String(l.kind),visible:l.visible,opacity:l.opacity,bounds:[b[0].as('px'),b[1].as('px'),b[2].as('px'),b[3].as('px')],has_user_mask:a.hasKey(s('hasUserMask'))&&a.getBoolean(s('hasUserMask')),has_layer_effects:a.hasKey(s('layerEffects'))};if(l.kind===LayerKind.TEXT){row.text=l.textItem.contents;row.font=l.textItem.font;row.size_px=l.textItem.size.as('px');row.tracking=l.textItem.tracking;row.horizontal_scale=l.textItem.horizontalScale;row.vertical_scale=l.textItem.verticalScale;row.faux_bold=l.textItem.fauxBold;row.faux_italic=l.textItem.fauxItalic;row.auto_leading=l.textItem.useAutoLeading;if(!row.auto_leading)row.leading_px=l.textItem.leading.as('px');}if(l.kind===LayerKind.SMARTOBJECT&&a.hasKey(s('smartObject'))){var so=a.getObjectValue(s('smartObject'));row.linked=so.hasKey(s('linked'))?so.getBoolean(s('linked')):false;}return row;}
function category(l){if(l.kind===LayerKind.TEXT)return /尺寸|掌围|长度|宽度|注：|尾注|注意事项/.test(l.name)?'尺寸与注意事项_可编辑文字':'标题与卖点_可编辑文字';if(/人物|穿戴|模特/.test(l.name))return '人物_智能对象与蒙版';if(/产品|实拍|商品/.test(l.name))return '产品实拍_智能对象';if(/背景|底色/.test(l.name))return '背景';if(/投影|阴影/.test(l.name))return '投影';return '装饰与其他';}
function groupLayers(d){app.activeDocument=d;var ls=[],runs=[],i;for(i=0;i<d.layers.length;i++)ls.push(d.layers[i]);for(i=0;i<ls.length;i++){var l=ls[i];if(l.typename==='LayerSet'){runs.push({existing:true,a:[l],c:l.name});continue;}if(l.isBackgroundLayer)l.isBackgroundLayer=false;var k=category(l),r=runs.length?runs[runs.length-1]:null;if(!r||r.existing||r.c!==k){r={existing:false,a:[],c:k};runs.push(r);}r.a.push(l);}for(i=0;i<runs.length;i++){r=runs[i];if(r.existing)continue;var g=d.layerSets.add();g.name=('0'+(i+1)).slice(-2)+'_'+r.c;g.blendMode=BlendMode.PASSTHROUGH;g.move(r.a[0],ElementPlacement.PLACEBEFORE);for(var j=r.a.length-1;j>=0;j--)r.a[j].move(g,ElementPlacement.INSIDE);}}
function ensureFolder(f){if(f.exists)return;if(!f.parent.exists)ensureFolder(f.parent);if(!f.create())throw Error('Cannot create output folder: '+f.fsName);}
function savePair(d,path,name){app.activeDocument=d;var folder=new Folder(path);ensureFolder(folder);var pd=new Folder(folder.fsName+'/PSD'),jd=new Folder(folder.fsName+'/JPG');ensureFolder(pd);ensureFolder(jd);var psd=new File(pd.fsName+'/'+name+'.psd'),jpg=new File(jd.fsName+'/'+name+'.jpg');if(psd.exists||jpg.exists)throw Error('Output exists; choose a new job_id/version');var po=new PhotoshopSaveOptions();po.layers=true;po.embedColorProfile=true;d.saveAs(psd,po,true,Extension.LOWERCASE);var jo=new JPEGSaveOptions();jo.quality=11;jo.embedColorProfile=true;d.saveAs(jpg,jo,true,Extension.LOWERCASE);return {psd:psd.fsName,jpg:jpg.fsName};}
function json(v){function quote(t){return '"'+t.replace(/[\\"\u0000-\u001f]/g,function(ch){var known={'"':'\\"','\\':'\\\\','\b':'\\b','\f':'\\f','\n':'\\n','\r':'\\r','\t':'\\t'};return known[ch]||'\\u'+('0000'+ch.charCodeAt(0).toString(16)).slice(-4);})+'"';}if(v===null)return 'null';var t=typeof v;if(t==='string')return quote(v);if(t==='number')return isFinite(v)?String(v):'null';if(t==='boolean')return String(v);var a=[],i;if(v instanceof Array){for(i=0;i<v.length;i++)a.push(json(v[i]));return '['+a.join(',')+']';}for(i in v)if(v.hasOwnProperty(i)&&typeof v[i]!=='undefined')a.push(quote(i)+':'+json(v[i]));return '{'+a.join(',')+'}';}
function writeJson(path,data){var f=new File(path);f.encoding='UTF8';if(!f.open('w'))throw Error('Cannot write '+path);f.write(json(data));f.close();}
return {begin:begin,end:end,color:color,rect:rect,text:text,fit:fit,placeImage:placeImage,replaceImage:replaceImage,groupLayers:groupLayers,savePair:savePair,placeEmbedded:placeEmbedded,frameMask:frameMask,effects:effects,styledText:styledText,assertFonts:assertFonts,layerEvidence:layerEvidence,ensureFolder:ensureFolder,json:json,writeJson:writeJson};
})();
